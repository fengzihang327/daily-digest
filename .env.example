# ============================================================
# 每日精读推报 · 环境变量模板
# 用法: cp .env.example .env 然后填写, .env 已被 gitignore 不会提交
# ============================================================

# ── DeepSeek API (必填) ──────────────────────────────────────
# 从 https://platform.deepseek.com → API Keys 创建
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API 地址(OpenAI 兼容格式), 一般无需修改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Stage-1 快速筛选模型(便宜)
DEEPSEEK_FAST_MODEL=deepseek-chat
# Stage-2 深度认知提炼模型: deepseek-chat 或 deepseek-reasoner
DEEPSEEK_DEEP_MODEL=deepseek-chat
# 采样温度(结构化输出场景建议低温, 0-1)
DEEPSEEK_TEMPERATURE=0.1

# ── 筛选与数量 ───────────────────────────────────────────────
# Stage-1 筛选阈值(>= 该分数入选)
MIN_SCORE=7
# 单日扫描总量上限
MAX_ARTICLES=400
# 单日 Stage-2 深读条数上限
MAX_DEEP_ARTICLES=8
# 产出日期时区
DIGEST_TZ=Asia/Shanghai

# ── 通知: Telegram (可选) ────────────────────────────────────
# 用 @BotFather 创建 Bot 获取 token; chat id 可用 @userinfobot 查询
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 通知: Resend 邮件 (可选) ─────────────────────────────────
# 从 https://resend.com 获取 API Key
RESEND_API_KEY=
RESEND_FROM=Daily Digest <onboarding@resend.dev>
RESEND_TO=you@example.com
